# NEXUS 2.0 — copy to .env (never commit .env) and fill in real values.
APP_ENV=development

# --- Database -------------------------------------------------------------
# Owner/DDL connection: used only by scripts/apply_migrations.py and scripts/bootstrap_roles.py.
NEXUS_OWNER_DATABASE_URL=
# Runtime connections. They MUST use the unprivileged roles so RLS is enforced.
# Supabase session pooler format: postgresql://<role>.<project-ref>:<password>@<region>.pooler.supabase.com:5432/<db>
DATABASE_URL=
WORKER_DATABASE_URL=
# Passwords for the two roles, read by scripts/bootstrap_roles.py (>= 24 chars, must differ).
NEXUS_APP_PASSWORD=
NEXUS_WORKER_PASSWORD=

# --- Supabase (client-side API; the service role key never goes to the browser) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- Auth ----------------------------------------------------------------
JWT_SECRET=
NEXUS_SECURITY_SALT=
# 0 in production: closes public self-registration.
ALLOW_REGISTRATION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# --- AI providers --------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Only set when a Veo model is enabled for the key; otherwise video stays NOT_CONFIGURED.
GEMINI_VIDEO_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
PAGESPEED_API_KEY=
IMAGE_PROVIDER_KEY=
VIDEO_PROVIDER_KEY=
VOICE_PROVIDER_KEY=

# --- Media provider overrides (generic HTTP JSON endpoints) ---------------
IMAGE_PROVIDER_URL=
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=

# --- Email / reporting ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
REPORT_RECIPIENT=

# --- Local docker compose ------------------------------------------------
# Password for the `db` service in docker-compose.yml (not the hosted database).
POSTGRES_PASSWORD=

# --- Tests (disposable database only) ------------------------------------
# Defaults point at scripts/start_test_pg.sh on port 5433.
NEXUS_TEST_OWNER_URL=
NEXUS_TEST_APP_URL=
NEXUS_TEST_WORKER_URL=
NEXUS_TEST_DB_NAME=nexus_test
